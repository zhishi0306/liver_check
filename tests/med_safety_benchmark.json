{
  "test_cases": [
    {
      "id": "DDI-001",
      "description": "华法林与复方新诺明合用",
      "input": {
        "current_drugs": ["Warfarin", "Aspirin"],
        "new_drug": "Sulfamethoxazole/Trimethoprim",
        "patient": {
          "age": 72,
          "eGFR": 45,
          "child_pugh": "A"
        }
      },
      "expected": {
        "detects_interaction": true,
        "severity": "major",
        "suggests_alternatives": true,
        "clinical_advice": "avoid_combination"
      }
    },
